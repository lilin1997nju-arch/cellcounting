# Paths are intentionally outside the source tree in production.
CELLVISION_DATA_ROOT=E:/CM/data
CELLVISION_ARTIFACT_ROOT=E:/CM/cellvision-artifacts
CELLVISION_MODEL_ROOT=E:/CM/cellvision-models
CELLVISION_SHARED_MODEL_ROOT=E:/CM/cellvision-models
CELLVISION_DB_ROOT=E:/CM/cellvision-db
CELLVISION_LOG_ROOT=E:/CM/cellvision-logs

# Keep the service local when using a host reverse proxy.
CELLVISION_HOST=127.0.0.1
CELLVISION_PORT=8777
CELLVISION_ALLOW_REMOTE=0
